@startuml briscola
package model {
    class Card <<record>> {
        - rank : Rank
        - suit : Suit
        + rank() : Rank
        + suit() : Suit
        + points() : int
        + toString() : String
    }

    class EmptyDeckException {
        + EmptyDeckException(m : String, causa : Throwable)
    }

    class TurnEndedException {
        + TurnEndedException(m : String, causa : Throwable)
    }

    class Deck {
        - cards : List<Card>
        + Deck()
        + Deck(shuffled : boolean)
        - initializeDeck() : void
        + shuffle() : void
        + drawCard() : Card
        + getSize() : int
        + isEmpty() : boolean
        + add(c : Card) : boolean
        + add(index : int, c : Card) : void
    }

    enum Suit {
        BASTONI
        COPPE
        DENARI
        SPADE
    }

    enum Rank {
        ASSO
        TRE
        RE
        CAVALLO
        FANTE
        SETTE
        SEI
        CINQUE
        QUATTRO
        DUE
        - points : int
        - strength : int
        + getPoints() : int
        + getStrength() : int
    }

    interface GameRules {
        + solveTable(cards : List<Card>, trumpSuit : Suit) : Card
        + computeScore(cards : List<Card>) : int
    }

    class BriscolaRules implements GameRules {
        + solveTable(cards : List<Card>, trumpSuit : Suit) : Card
        + computeScore(cards : List<Card>) : int
    }

    class Game {
        - rules : GameRules
        - numberOfPlayers : int
        - playerList : List<Player>
        - team1 : Team
        - team2 : Team
        - deck : Deck
        - table : Table
        - briscolaCard : Card
        - trumpSuit : Suit
        - currentPlayer : Player
        - currentPhase : Phase
        - currentStatus : GameStatus
        - observers : List<GameObserver>
        --
        + Game(n : Integer, pList : List<Player>, team1 : Team, team2 : Team, rules : GameRules, obs : List<GameObserver>)
        + getState() : GameState
        + playersAreMixed() : boolean
        + mixPlayers() : void
        + initializeGame() : void
        + dealInitialCards() : void
        + revealBriscola() : void
        + dealCard(player : Player) : void
        + dealCards() : void
        + drawAfterTrick(winner : Player) : void
        + changePhase(phase : Phase) : void
        + askPlayerForCard(player : Player) : Card
        + playCard(player : Player, card : Card) : void
        + solveTable() : void
        + addCardsToTeamPile(table : Table, team : Team) : void
        + updatePlayerOrder(winner : Player) : void
        + updateCurrentPlayer() : void
        + getPhase() : Phase
        + computeScore(team : Team) : int
        + computeWinningTeam() : Team
        + isGameOver() : boolean
        + addObserver(o : GameObserver) : boolean
        + removeObserver(o : GameObserver) : void
        + notifyObservers() : void
        + updateGame() : void
        + isReady() : boolean
    }

    class GameBuilder {
        - numberOfPlayers : int
        - playersPerTeam : int
        - playerList : List<Player>
        - team1 : Team
        - team2 : Team
        - rules : GameRules
        - observers : List<GameObserver>
        --
        + withRules(rules : GameRules) : GameBuilder
        + withObservers(observers : List<GameObserver>) : GameBuilder
        + withNumberOfPlayers(n : int) : GameBuilder
        + addHumanPlayer(name : String, team : String, humanStrategy : HumanStrategy) : void
        + withPlayers(playernames : String[], teams : String[], humanStrategy : HumanStrategy) : GameBuilder
        + fillPlayers(s : PlayerStrategy) : GameBuilder
        + build() : Game
    }

    class GameState <<record>> {
        - phase : Phase
        - status : GameStatus
        - currentPlayerName : String
        - briscolaCard : Card
        - trumpSuit : Suit
        - remainingCards : int
        - tableCards : Map<Card, PlayerState>
        - players : List<PlayerState>
        - teamScores : List<Integer>
        --
        + phase() : Phase
        + status() : GameStatus
        + currentPlayerName() : String
        + briscolaCard() : Card
        + trumpSuit() : Suit
        + remainingCards() : int
        + tableCards() : Map<Card, PlayerState>
        + players() : List<PlayerState>
        + teamScores() : List<Integer>
    }

    enum GameStatus {
        READY
        NOTREADY
    }

    enum Phase {
        INITIALIZATION
        DEALING
        TURN
        COLLECTINGTRICK
        ENDGAME
        ENDED
    }

    class Hand {
        - cards : List<Card>
        --
        + Hand()
        + addCard(card : Card) : void
        + removeCard(card : Card) : boolean
        + contains(card : Card) : boolean
        + showCards() : List<Card>
        + getSize() : int
    }

    class Table {
        - currentCards : Map<Player, Card>
        --
        + Table()
        + addCard(player : Player, card : Card) : void
        + getAllCards() : List<Card>
        + getFirstPlayer() : Player
        + getFirstCard() : Card
        + clear() : void
        + howManyCards() : int
        + getPlayerByCard(card : Card) : Player
    }

    class Team {
        - ID : String
        - wonCards : List<Card>
        - playersList : List<Player>
        --
        + Team(id : String)
        + addCardsToPile(cards : List<Card>) : void
        + addPlayer(p : Player) : void
        + size() : int
        + equals(obj : Object) : boolean
        + hashCode() : int
        + getPile() : List<Card>
        + getScore() : int
        + getId() : String
        + getWonCards() : List<Card>
        + toString() : String
    }

    class Player {
        - strategy : PlayerStrategy
        - NICKNAME : String
        # hand : Hand
        - team : Team
        --
        + Player(nickname : String, team : Team, s : PlayerStrategy)
        + receiveCard(card : Card) : void
        + playCard(card : Card) : Card
        + playCard() : Card
        + setTeam(team : Team) : void
        + getHand() : Hand
        + getTeam() : Team
        + getNickname() : String
    }

    class HumanStrategy implements PlayerStrategy {
        - view : View
        --
        + HumanStrategy(v : View)
        + chooseCard(h : Hand) : Card
    }

    interface PlayerStrategy {
        + chooseCard(hand : Hand) : Card
    }

    class RandomStrategy implements PlayerStrategy {
        + chooseCard(hand : Hand) : Card
    }

    class UserProfile {
        - nickname : String
        - avatarPath : String
        - gamesPlayed : int
        - wins : int
        - losses : int
        - level : int
        --
        + UserProfile(nickname : String, avatarPath : String)
        + addWin() : void
        + addLoss() : void
        - updateLevel() : void
    }

    interface GameObserver {
        + update(game : Game) : void
    }

    Game --o GameRules
    Game --* Team
    Game --* Deck
    Game --* Table
    Game --o Card : briscolaCard
    Game --* "2..4" Player
    Game --* Phase
    Game --* GameStatus
    Player --o Team
    Player --* Hand
    Player --o PlayerStrategy
    HumanStrategy --> view.View
    GameBuilder ..> Game : creates
    GameBuilder --> Team
    GameBuilder --> Player
    GameBuilder --> GameRules
    GameBuilder --> GameObserver
    GameBuilder ..> HumanStrategy
    GameBuilder ..> PlayerStrategy
    Game ..> GameState
    GameState --> Phase
    GameState --> GameStatus
    GameState --> Suit
    GameState --> Card
    GameState --> PlayerState
    Deck --o Card
    Deck ..> EmptyDeckException : throws
    Table --o Card
    Hand --o Card
    Team --o Card
    Card --> Suit
    Card --> Rank
    Game --o GameObserver
}

package controller {
    class Controller {
        ~ game : Game
        ~ view : View
        --
        + Controller()
        + startGame(rules : GameRules, n : int, players : String[], teams : String[]) : void
    }
}

package view {
    interface View extends model.GameObserver {
        + askPlayerForCard(hand : Hand) : Card
    }

    class ConsoleView implements View {
        - state : GameState
        - scanner : Scanner
        --
        + ConsoleView()
        + update(game : Game) : void
        + getState() : GameState
        + askPlayerForCard(hand : Hand) : Card
        + printState() : void
    }
}

Controller --* model.Game
Controller --o view.View
Controller ..> model.GameBuilder
Controller ..> model.HumanStrategy
Controller ..> model.RandomStrategy
view.ConsoleView --> model.GameState
view.View ..> model.Hand
view.View ..> model.Card
Controller --> model.UserProfile
@enduml
