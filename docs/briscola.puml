@startuml briscola
package model {
    class Card <<record>> {
        - rank : Rank
        - suit : Suit
        + rank() : Rank
        + suit() : Suit
        + points() : int
        + toString() : String
    }

    class EmptyDeckException {
        + EmptyDeckException(m : String, causa : Throwable)
    }

    class TurnEndedException {
        + TurnEndedException(m : String, causa : Throwable)
    }

    class Deck {
        - cards : List<Card>
        + Deck()
        + Deck(shuffled : boolean)
        - initializeDeck() : void
        + shuffle() : void
        + drawCard() : Card
        + getSize() : int
        + isEmpty() : boolean
        + add(c : Card) : boolean
    }

    enum Suit {
        BASTONI
        COPPE
        DENARI
        SPADE
    }

    enum Rank {
        ASSO
        TRE
        RE
        CAVALLO
        FANTE
        SETTE
        SEI
        CINQUE
        QUATTRO
        DUE
        - points : int
        - strength : int
        + getPoints() : int
        + getStrength() : int
    }

    interface GameRules {
        + solveTable(cards : List<Card>, trumpSuit : Suit) : Card
        + computeScore(cards : List<Card>) : int
    }

    class BriscolaRules implements GameRules {
        + solveTable(cards : List<Card>, trumpSuit : Suit) : Card
        + computeScore(cards : List<Card>) : int
    }

    class Game {
        - rules : GameRules
        - numberOfPlayers : int
        - playerList : List<Player>
        - teams : List<Team>
        - deck : Deck
        - table : Table
        - briscolaCard : Card
        - trumpSuit : Suit
        - currentPlayer : Player
        - currentPhase : Phase
        - currentStatus : GameStatus
        - observers : List<GameObserver>
        --
        + Game(rules : GameRules, playerNames : String...)
        + initializeGame() : void
        + dealInitialCards() : void
        + revealBriscola() : void
        + dealCard(player : Player) : void
        + dealCards() : void
        + drawAfterTrick(winner : Player) : void
        + changePhase(phase : Phase) : void
        + askPlayerForCard(player : Player) : Card
        + playCard(player : Player, card : Card) : void
        + solveTable() : void
        + addCardsToTeamPile(table : Table, team : Team) : void
        + updatePlayerOrder(winner : Player) : void
        + updateCurrentPlayer() : void
        + getPhase() : Phase
        + computeScore(team : Team) : int
        + computeWinningTeam() : Team
        + isGameOver() : boolean
        + addObserver(o : GameObserver) : void
        + removeObserver(o : GameObserver) : void
        + notifyObservers() : void
        + updateGame() : void
        + isReady() : boolean
    }

    enum GameStatus {
        READY
        NOTREADY
    }

    enum Phase {
        INITIALIZATION
        DEALING
        TURN
        WAIT_HUMAN_PLAY
        COLLECTINGTRICK
        ENDGAME
        ENDED
    }

    class Hand {
        - cards : List<Card>
        --
        + Hand()
        + addCard(card : Card) : void
        + removeCard(card : Card) : boolean
        + contains(card : Card) : boolean
        + showCards() : List<Card>
        + getSize() : int
    }

    class Table {
        - currentCards : Map<Player, Card>
        --
        + Table()
        + addCard(player : Player, card : Card) : void
        + getAllCards() : List<Card>
        + getFirstPlayer() : Player
        + getFirstCard() : Card
        + clear() : void
        + howManyCards() : int
        + getPlayerByCard(card : Card) : Player
    }

    class Team {
        - ID : String
        - wonCards : List<Card>
        --
        + Team(id : String)
        + addCardsToPile(cards : List<Card>) : void
        + getPile() : List<Card>
        + getScore() : int
        + getId() : String
        + getWonCards() : List<Card>
        + toString() : String
    }

    abstract class Player {
        - NICKNAME : String
        # hand : Hand
        - team : Team
        --
        + Player(nickname : String, team : Team)
        + receiveCard(card : Card) : void
        + playCard(card : Card) : Card
        + getHand() : Hand
        + getTeam() : Team
        + getNickname() : String
    }

    class HumanPlayer extends Player {
        + HumanPlayer(nickname : String, team : Team)
    }

    class AIPlayer extends Player {
        - strategy : AIStrategy
        --
        + AIPlayer(nickname : String, team : Team, strategy : AIStrategy)
        + playCard() : Card
        + playTurn(table : Table, trumpSuit : Suit) : Card
        + setStrategy(strategy : AIStrategy) : void
    }

    interface AIStrategy {
        + chooseCard(hand : Hand) : Card
    }

    class RandomStrategy implements AIStrategy {
        + chooseCard(hand : Hand) : Card
    }

    class UserProfile {
        - nickname : String
        - avatarPath : String
        - gamesPlayed : int
        - wins : int
        - losses : int
        - level : int
        --
        + UserProfile(nickname : String, avatarPath : String)
        + addWin() : void
        + addLoss() : void
        - updateLevel() : void
    }

    interface GameObserver {
        + onGameChanged(game : Game) : void
    }

    Game --o GameRules
    Game --* Team
    Game --* Deck
    Game --* Table
    Game --o Card : briscolaCard
    Game --* "2..4" Player
    Game --* Phase
    Game --* GameStatus
    Player --o Team
    Player --* Hand
    AIPlayer --* AIStrategy
    Deck --o Card
    Deck ..> EmptyDeckException : throws
    Table --o Card
    Hand --o Card
    Team --o Card
    Card --> Suit
    Card --> Rank
    Game --o GameObserver
}

package controller {
    class Controller {
        ~ game : Game
        - view : GameView
        --
        + Controller()
        + startGame(rules : GameRules, playerNames : String...) : void
        + handleCardSelection(player : Player, card : Card) : void
        + nextTurn() : void
    }
}

package view {
    class GameView implements model.GameObserver {
        + onGameChanged(game : Game) : void
        + showTable(table : Table) : void
        + showHand(hand : Hand) : void
        + showBriscola(card : Card) : void
        + askCardSelection(player : Player) : Card
    }
}

Controller --* model.Game
Controller --* view.GameView
Controller --> model.UserProfile
@enduml
